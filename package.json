{
  "name": "nami-motion-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w nami-motion",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "example": "npm run start -w example",
    "docs": "npm run dev -w docs",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "packageManager": "npm@11.6.2"
}
