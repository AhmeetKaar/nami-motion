{
  "name": "react-native-ai-animations",
  "version": "0.8.0",
  "description": "Animated React Native and Expo components for AI chat apps: streaming text, shimmer loading text, thinking and status indicators, voice orbs and waveforms, image and video generation loaders, question cards and reasoning effort bars. Built on Reanimated and Skia.",
  "license": "MIT",
  "author": "Ahmet Kar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmeetKaar/nami-motion.git"
  },
  "homepage": "https://nami-motion-web.vercel.app/",
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "ai-chat",
    "chatbot",
    "llm",
    "chat-ui",
    "animation",
    "animations",
    "reanimated",
    "skia",
    "streaming-text",
    "shimmer",
    "loading",
    "loader",
    "typing-indicator",
    "thinking",
    "reasoning",
    "voice",
    "waveform",
    "orb",
    "generative-ui",
    "ios",
    "android"
  ],
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "types": "./lib/typescript/src/theme/index.d.ts",
      "default": "./lib/module/theme/index.js"
    },
    "./text": {
      "source": "./src/text/index.ts",
      "types": "./lib/typescript/src/text/index.d.ts",
      "default": "./lib/module/text/index.js"
    },
    "./brand": {
      "source": "./src/brand/index.ts",
      "types": "./lib/typescript/src/brand/index.d.ts",
      "default": "./lib/module/brand/index.js"
    },
    "./chat": {
      "source": "./src/chat/index.ts",
      "types": "./lib/typescript/src/chat/index.d.ts",
      "default": "./lib/module/chat/index.js"
    },
    "./skia": {
      "source": "./src/skia/index.ts",
      "types": "./lib/typescript/src/skia/index.d.ts",
      "default": "./lib/module/skia/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "prepack": "bob build",
    "changeset": "changeset",
    "release": "bob build && changeset publish"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.4.0",
    "react": ">=19.2.0",
    "react-native": ">=0.83.0",
    "react-native-reanimated": ">=4.2.0",
    "react-native-worklets": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shopify/react-native-skia": "2.4.18",
    "@types/react": "~19.2.2",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.43.2",
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.4",
    "typescript": "~5.9.2"
  },
  "packageManager": "npm@11.6.2"
}
